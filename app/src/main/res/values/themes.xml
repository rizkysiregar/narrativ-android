<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The window is dark so nothing flashes white before Compose draws the first frame. -->
    <style name="Theme.Narrativ" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_base</item>
    </style>

    <!-- Launch theme: system splash on the app background, then handed over to the real theme. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_base</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Narrativ</item>
    </style>
</resources>
